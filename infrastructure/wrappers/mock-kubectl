#!/usr/bin/env bash
# mock-kubectl — kubectl mock/live router for Hermes DevOps labs
# Usage: Add this directory to PATH before real kubectl: export PATH="$(pwd)/wrappers:$PATH"
#
# HERMES_LAB_MODE=mock  -> serve pre-baked JSON files (offline, free)
# HERMES_LAB_MODE=live  -> pass through to real kubectl (requires K8s cluster)
# HERMES_LAB_SCENARIO=clean|messy|crashloop -> select scenario variant (default: clean)
# HERMES_LAB_SCENARIO=image-pull|crashloop2|oom|liveness|missing-secret|port-mismatch -> Phase 6 K8S-02 scenarios
# HERMES_LAB_GOVERNANCE=L1|L2|L3|L4 -> enforce wrapper_allowlist from governance/*.yaml
# HERMES_LAB_TRACK=track-a|track-b|track-c -> required when HERMES_LAB_GOVERNANCE=L4 (3 track-specific files)
#
set -euo pipefail

MOCK_DATA_DIR="${MOCK_DATA_DIR:-$(dirname "$0")/../mock-data}"
LAB_MODE="${HERMES_LAB_MODE:-live}"
SCENARIO="${HERMES_LAB_SCENARIO:-clean}"

if [[ "$LAB_MODE" != "mock" ]]; then
  # Find real kubectl by searching PATH, excluding our own directory,
  # so the symlink `kubectl -> mock-kubectl` doesn't create an infinite loop.
  WRAPPER_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
  REAL_BIN=""
  IFS=':' read -ra _PATH_PARTS <<< "$PATH"
  for _dir in "${_PATH_PARTS[@]}"; do
    [[ "$_dir" == "$WRAPPER_DIR" ]] && continue
    if [[ -x "$_dir/kubectl" ]]; then
      REAL_BIN="$_dir/kubectl"
      break
    fi
  done
  if [[ -z "$REAL_BIN" ]]; then
    printf 'ERROR: real kubectl not found in PATH (excluding wrapper dir)\n' >&2
    exit 127
  fi
  exec "$REAL_BIN" "$@"
fi

# ── GOVERNANCE PRE-FLIGHT ───────────────────────────────────────────────
# Phase 7: Enforce wrapper_allowlist from the active governance YAML file.
# Silent pass-through if HERMES_LAB_GOVERNANCE is not set (backward compat).
GOVERNANCE="${HERMES_LAB_GOVERNANCE:-}"
TOOL_KEY="kubectl"
if [[ -n "$GOVERNANCE" ]]; then
  TRACK="${HERMES_LAB_TRACK:-}"
  COURSE_DIR="$(cd "$(dirname "$0")/../.." && pwd)"

  # Resolve governance file path
  if [[ "$GOVERNANCE" == "L4" ]]; then
    if [[ -z "$TRACK" ]]; then
      printf 'WARNING: HERMES_LAB_GOVERNANCE=L4 requires HERMES_LAB_TRACK=track-{a,b,c}. Defaulting to track-a.\n' >&2
      TRACK="track-a"
    fi
    GOVERNANCE_FILE="${COURSE_DIR}/governance/governance-L4-${TRACK}.yaml"
  else
    GOVERNANCE_FILE="${COURSE_DIR}/governance/governance-${GOVERNANCE}.yaml"
  fi

  if [[ ! -f "$GOVERNANCE_FILE" ]]; then
    printf 'GOVERNANCE ERROR: Cannot find %s\n' "$GOVERNANCE_FILE" >&2
    exit 1
  fi

  # Extract wrapper_allowlist for kubectl from the yaml file using awk.
  # Parses the kubectl: subsection under wrapper_allowlist: top-level key.
  # gsub also converts YAML string escapes: \\X -> \X (e.g., "\\d" in yaml -> \d)
  ALLOWED_PREFIXES=$(awk -v tool="  ${TOOL_KEY}:" '
    /^wrapper_allowlist:/ { in_wa=1; next }
    in_wa && $0 == tool { in_tool=1; next }
    in_tool && /^    - / {
      line=$0; gsub(/^    - "|"$/, "", line); gsub(/\\\\/, "\\", line); print line; next
    }
    in_tool && /^  [a-z]/ { in_tool=0 }
    in_wa && /^[a-z]/ { in_wa=0; in_tool=0 }
  ' "$GOVERNANCE_FILE")

  # Check if the current command prefix matches any allowed prefix
  # kubectl commands use "$1 $2" as check key (e.g., "get pods", "describe pod", "rollout history")
  CMD_CHECK="${1:-} ${2:-}"
  ALLOWED=0
  while IFS= read -r prefix; do
    [[ -z "$prefix" ]] && continue
    if [[ "$CMD_CHECK" == "$prefix"* ]]; then
      ALLOWED=1
      break
    fi
  done <<< "$ALLOWED_PREFIXES"

  if [[ "$ALLOWED" == "0" ]]; then
    printf '\n' >&2
    printf '╔══════════════════════════════════════════════════╗\n' >&2
    printf '║           [ GOVERNANCE REJECTED ]                ║\n' >&2
    printf '╠══════════════════════════════════════════════════╣\n' >&2
    printf '║ Command:      kubectl %s\n' "$*" >&2
    printf '║ Governance:   %s' "$GOVERNANCE" >&2
    [[ -n "$TRACK" ]] && printf ' (%s)' "$TRACK" >&2
    printf '\n' >&2
    printf '║ Block reason: Not in %s wrapper_allowlist.%s\n' "$GOVERNANCE" "$TOOL_KEY" >&2
    printf '║ File:         %s\n' "$GOVERNANCE_FILE" >&2
    printf '║ To unblock:   Upgrade HERMES_LAB_GOVERNANCE or add to wrapper_allowlist\n' >&2
    printf '║ SOUL.md:      Behavioral NEVER rules may also apply at Layer 3\n' >&2
    printf '╚══════════════════════════════════════════════════╝\n' >&2
    printf '\n' >&2
    exit 1
  fi
fi
# ────────────────────────────────────────────────────────────────────────

# ── MOCK MODE BANNER ────────────────────────────────────────────────────
printf '\n'
printf '╔══════════════════════════════════════════╗\n'
printf '║            [ MOCK MODE ]                 ║\n'
printf '║   Data source: pre-baked JSON files      ║\n'
printf '║   Set HERMES_LAB_MODE=live for real K8s  ║\n'
printf '╚══════════════════════════════════════════╝\n'
printf '\n'
# ────────────────────────────────────────────────────────────────────────

# Build a normalized command key from the first 3 positional args
CMD="${1:-} ${2:-} ${3:-}"

case "$CMD" in
  "get pods "* | "get pods")
    case "$SCENARIO" in
      image-pull)     cat "$MOCK_DATA_DIR/kubernetes/01-image-pull-get-pods.json" ;;
      crashloop2)     cat "$MOCK_DATA_DIR/kubernetes/02-crashloop2-get-pods.json" ;;
      oom)            cat "$MOCK_DATA_DIR/kubernetes/03-oom-get-pods.json" ;;
      liveness)       cat "$MOCK_DATA_DIR/kubernetes/04-liveness-get-pods.json" ;;
      missing-secret) cat "$MOCK_DATA_DIR/kubernetes/05-missing-secret-get-pods.json" ;;
      port-mismatch)  cat "$MOCK_DATA_DIR/kubernetes/06-port-mismatch-get-pods.json" ;;
      messy|crashloop) cat "$MOCK_DATA_DIR/kubernetes/get-pods-crashloop.json" ;;
      *)              cat "$MOCK_DATA_DIR/kubernetes/get-pods-healthy.json" ;;
    esac
    ;;
  "get pod "*)
    # kubectl get pod <name> -o json — serve the OOM describe for any pod name
    cat "$MOCK_DATA_DIR/kubernetes/describe-pod-oom.json"
    ;;
  "describe pod "*)
    # kubectl describe pod returns text, not JSON — serve a text mock
    case "$SCENARIO" in
      image-pull)     cat "$MOCK_DATA_DIR/kubernetes/01-image-pull-describe.txt" ;;
      crashloop2)     cat "$MOCK_DATA_DIR/kubernetes/02-crashloop2-describe.txt" ;;
      oom)            cat "$MOCK_DATA_DIR/kubernetes/03-oom-describe.txt" ;;
      liveness)       cat "$MOCK_DATA_DIR/kubernetes/04-liveness-describe.txt" ;;
      missing-secret) cat "$MOCK_DATA_DIR/kubernetes/05-missing-secret-describe.txt" ;;
      *)
        # FALL-THROUGH: existing inline-printf describe (unchanged for messy/crashloop/clean/port-mismatch)
        printf 'Name:         api-deployment-def456\n'
        printf 'Namespace:    default\n'
        printf 'Status:       Running\n'
        printf 'IP:           10.0.1.11\n'
        printf 'Containers:\n'
        printf '  api:\n'
        printf '    Image:          api:v2.1.0\n'
        printf '    Limits:\n'
        printf '      cpu:          500m\n'
        printf '      memory:       256Mi\n'
        printf '    Requests:\n'
        printf '      cpu:          100m\n'
        printf '      memory:       128Mi\n'
        printf '    Last State:     Terminated\n'
        printf '      Reason:       OOMKilled\n'
        printf '      Exit Code:    137\n'
        printf '      Started:      Sat, 04 Apr 2026 12:00:00 +0000\n'
        printf '      Finished:     Sat, 04 Apr 2026 12:04:55 +0000\n'
        printf '    Ready:          False\n'
        printf '    Restart Count:  8\n'
        printf 'Events:\n'
        printf '  Type     Reason     Age    From     Message\n'
        printf '  ----     ------     ---    ----     -------\n'
        printf '  Warning  OOMKilling  2m    kubelet  Container api exceeded memory limit, killed.\n'
        printf '  Warning  BackOff     1m    kubelet  Back-off restarting failed container api\n'
        ;;
    esac
    ;;
  "get nodes "* | "get nodes")
    printf '{"apiVersion":"v1","kind":"NodeList","items":[{"metadata":{"name":"lab-control-plane"},"status":{"conditions":[{"type":"Ready","status":"True"}]}}]}\n'
    ;;
  "top pods "* | "top pods")
    printf 'NAME                          CPU(cores)   MEMORY(bytes)\n'
    printf 'webapp-deployment-abc123      25m          180Mi\n'
    printf 'api-deployment-def456         5m           251Mi\n'
    printf 'memory-hog-mno345             12m          410Mi\n'
    ;;
  "logs "*)
    case "$SCENARIO" in
      crashloop2) cat "$MOCK_DATA_DIR/kubernetes/02-crashloop2-logs.txt" ;;
      *)
        printf 'No mock logs available for scenario: %s\n' "$SCENARIO" >&2
        exit 1
        ;;
    esac
    ;;
  "get endpoints "* | "get endpoints")
    case "$SCENARIO" in
      port-mismatch) cat "$MOCK_DATA_DIR/kubernetes/06-port-mismatch-get-endpoints.json" ;;
      *)
        printf '{"apiVersion":"v1","kind":"EndpointsList","items":[]}\n'
        ;;
    esac
    ;;
  *)
    printf 'MOCK ERROR: No mock defined for: kubectl %s\n' "$*" >&2
    printf 'Available mocks: get pods, get pod <name>, describe pod <name>, get nodes, top pods, logs <pod>, get endpoints\n' >&2
    exit 1
    ;;
esac
