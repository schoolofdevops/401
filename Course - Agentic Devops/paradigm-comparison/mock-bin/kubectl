  Warning  Failed     17m (x4 over 18m)  kubelet            Failed to pull image "registry.internal/payments/ledger-worker:v2.4.99": rpc error: code = NotFound desc = manifest for registry.internal/payments/ledger-worker:v2.4.99 not found: manifest unknown
  Warning  Failed     17m (x4 over 18m)  kubelet            Error: ErrImagePull
  Warning  Failed     2m (x65 over 18m)  kubelet            Error: ImagePullBackOff
"""
    return f"Name: {pod_name}\nNamespace: {namespace}\nStatus: Running\nEvents: <none>\n"


def _logs(pod_name: str, namespace: str, previous: bool) -> str:
    if namespace != "payments":
        return "2026-04-07T07:15:01Z INFO  app started, listening on :8080\n"
    if pod_name.startswith("checkout-api"):
        if previous:
            return """2026-04-07T07:55:00Z INFO  checkout-api v3.8.2 starting
2026-04-07T07:55:01Z INFO  connected to postgres://payments-db:5432/checkout
2026-04-07T07:55:02Z INFO  warming order cache (target=200000 entries)
2026-04-07T07:56:14Z INFO  cache warm at 78432/200000 entries (heap=174MiB)
2026-04-07T07:57:31Z WARN  cache warm at 152011/200000 entries (heap=238MiB) — approaching limit
2026-04-07T07:58:22Z ERROR runtime: out of memory: cannot allocate 8388608-byte block
2026-04-07T07:58:23Z FATAL exit status 137 (OOMKilled)
"""
        # No --previous → no logs from current container (it never started)
        return "Error from server (BadRequest): container \"checkout-api\" in pod \"" + pod_name + "\" is waiting to start: CrashLoopBackOff\n"
    if pod_name.startswith("ledger-worker"):
        return "Error from server (BadRequest): container \"ledger-worker\" in pod \"" + pod_name + "\" is waiting to start: trying and failing to pull image\n"
    return ""


