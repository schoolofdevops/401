def _describe_pod(pod_name: str, namespace: str) -> str:
    if namespace != "payments":
        return (
            f"Name:         {pod_name}\n"
            f"Namespace:    {namespace}\n"
            f"Status:       Running\n"
            f"Events:       <none>\n"
        )
    if pod_name.startswith("checkout-api"):
        return f"""Name:         {pod_name}
Namespace:    payments
Priority:     0
Node:         kind-worker/172.18.0.3
Start Time:   Mon, 07 Apr 2026 06:42:11 +0530
Labels:       app=checkout-api
Status:       Running
IP:           10.244.1.17
Containers:
  checkout-api:
    Image:          registry.internal/payments/checkout-api:v3.8.2
    State:          Waiting
      Reason:       CrashLoopBackOff
    Last State:     Terminated
      Reason:       OOMKilled
      Exit Code:    137
      Started:      Tue, 07 Apr 2026 07:55:00 +0530
      Finished:     Tue, 07 Apr 2026 07:58:23 +0530
    Ready:          False
    Restart Count:  11
    Limits:
      memory:  256Mi
    Requests:
      memory:  128Mi

