#!/usr/bin/env python3
"""
Mock kubectl for paradigm-comparison agent testing.

Returns canned data for the 'payments' namespace so the LangGraph and
Hermes agents can be exercised end-to-end without a real cluster.

Supports the kubectl invocations used by both agents:
  - get pods -n <ns> -o json
  - describe pod <name> -n <ns>
  - logs <name> -n <ns> [-c <container>] [--tail=N] [--previous]
  - get deployments -n <ns> -o json
  - rollout history deployment/<name> -n <ns>
  - get events -n <ns> --sort-by=... --field-selector=...

For the namespace 'payments', returns realistic unhealthy pod state:
  - One pod in CrashLoopBackOff with OOMKilled logs
  - One pod in ImagePullBackOff with bad image tag
  - One healthy pod
For any other namespace, returns 'all healthy' state.

Activated by placing this directory ahead of /usr/local/bin on PATH.
"""

from __future__ import annotations

import json
import sys
from typing import List


def _ns_from(args: List[str]) -> str:
    if "-n" in args:
        return args[args.index("-n") + 1]
    if "--namespace" in args:
        return args[args.index("--namespace") + 1]
    return "default"


