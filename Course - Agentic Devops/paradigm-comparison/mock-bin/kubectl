    if namespace != "payments":
        return {"kind": "List", "apiVersion": "apps/v1", "items": []}
    return {
        "kind": "List",
        "apiVersion": "apps/v1",
        "items": [
            {
                "metadata": {"name": "checkout-api", "namespace": "payments"},
                "spec": {"replicas": 3},
                "status": {
                    "replicas": 3,
                    "readyReplicas": 0,
                    "unavailableReplicas": 3,
                    "updatedReplicas": 3,
                },
            },
            {
                "metadata": {"name": "ledger-worker", "namespace": "payments"},
                "spec": {"replicas": 2},
                "status": {
                    "replicas": 2,
                    "readyReplicas": 0,
                    "unavailableReplicas": 2,
                },
            },
            {
                "metadata": {"name": "fraud-scorer", "namespace": "payments"},
                "spec": {"replicas": 2},
                "status": {"replicas": 2, "readyReplicas": 2, "unavailableReplicas": 0},
            },
        ],
    }


def _events(namespace: str) -> str:
    if namespace != "payments":
        return "No resources found in " + namespace + " namespace.\n"
    return """LAST SEEN   TYPE      REASON              OBJECT                                  MESSAGE
2m          Warning   BackOff             pod/checkout-api-6c4f7d9b5-xz9k2        Back-off restarting failed container
7m          Warning   OOMKilling          pod/checkout-api-6c4f7d9b5-xz9k2        Memory cgroup out of memory: Killed process 1
17m         Warning   Failed              pod/ledger-worker-58c9b76f4d-q4r7t      Failed to pull image "registry.internal/payments/ledger-worker:v2.4.99": manifest unknown
17m         Warning   Failed              pod/ledger-worker-58c9b76f4d-q4r7t      Error: ErrImagePull
2m          Warning   Failed              pod/ledger-worker-58c9b76f4d-q4r7t      Error: ImagePullBackOff
22m         Warning   FailedScheduling    pod/checkout-api-6c4f7d9b5-xz9k2        0/4 nodes had untolerated taint
"""


def _rollout_history(deployment: str, namespace: str) -> str:
    if namespace != "payments":
        return "deployment.apps/" + deployment + "\nREVISION  CHANGE-CAUSE\n1         <none>\n"
    if "checkout-api" in deployment:
        return """deployment.apps/checkout-api
REVISION  CHANGE-CAUSE
4         kubectl rollout restart deployment/checkout-api
5         release: v3.8.1 → v3.8.2 (memory limit unchanged at 256Mi)
6         <none>
"""
    return f"deployment.apps/{deployment}\nREVISION  CHANGE-CAUSE\n1         <none>\n"


def main(argv: List[str]) -> int:
    if len(argv) < 2:
        print("kubectl (mock): no command", file=sys.stderr)
        return 0

    cmd = argv[1]
    rest = argv[2:]
    namespace = _ns_from(rest)

    if cmd == "get" and rest and rest[0] == "pods":
        print(json.dumps(_pods_json(namespace)))
        return 0

    if cmd == "get" and rest and rest[0] == "deployments":
        print(json.dumps(_deployments_json(namespace)))
        return 0

    if cmd == "get" and rest and rest[0] == "events":
        sys.stdout.write(_events(namespace))
        return 0

    if cmd == "describe" and rest and rest[0] == "pod":
        pod_name = rest[1]
        sys.stdout.write(_describe_pod(pod_name, namespace))
        return 0

    if cmd == "logs":
        pod_name = rest[0]
        previous = "--previous" in rest
        out = _logs(pod_name, namespace, previous)
        if out.startswith("Error from server"):
            sys.stderr.write(out)
            return 1
        sys.stdout.write(out)
        return 0

    if cmd == "rollout" and rest and rest[0] == "history":
        # form: rollout history deployment/<name> -n <ns>
        target = rest[1] if len(rest) > 1 else ""
        deployment = target.split("/", 1)[1] if "/" in target else target
        sys.stdout.write(_rollout_history(deployment, namespace))
        return 0

    if cmd == "version":
        print(json.dumps({
            "clientVersion": {"gitVersion": "v1.32.3-mock"},
            "serverVersion": {"gitVersion": "v1.32.3-mock"},
        }))
        return 0

    sys.stderr.write(f"kubectl (mock): unsupported command: {cmd} {' '.join(rest)}\n")
    return 1


if __name__ == "__main__":
    sys.exit(main(sys.argv))
